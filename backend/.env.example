# ── Original project settings (unchanged) ───────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_RECOMMENDER_ENABLED=true
CHARGER_URL=https://charger.philfan.cn/
ZJU_CHARGER_API_BASE_URL=https://charger.philfan.cn
ZJU_CHARGER_STATIONS_PATH=/api/status
ZJU_CHARGER_SITE_URL=https://charger.philfan.cn/
ZJU_CHARGER_API_TIMEOUT=8

# ── GeoAgent upgrade ─────────────────────────────────────────────────────────

# "deepseek" = real function calling via DEEPSEEK_API_KEY above (falls back to
#   rule_fallback per-call automatically if the API errors — see
#   agent/llm_client.py AutoFallbackChatBackend).
# "rule_fallback" = force the deterministic rule engine even if a key is set
#   (useful for demos/dev without spending API credits, and is how this
#   project's own agent logic was tested while being built).
# Leave unset to auto-pick: deepseek if DEEPSEEK_API_KEY is set, else rule_fallback.
AGENT_LLM_BACKEND=

# Geocoding: AMap (高德地图) Web API key. Without it, agent/tools/geocode_tool.py
# falls back to a local gazetteer built from the project's own POI/study-room names.
AMAP_API_KEY=
AMAP_BASE_URL=https://restapi.amap.com/v3/geocode/geo

# "inprocess" (default) = call AMap/the local gazetteer directly in this
#   Python process (see AMAP_API_KEY above).
# "mcp" = geocode via the real Node MCP server in mcp-server/ instead (build
#   it first: `cd mcp-server && npm install && npm run build`), falling
#   through to the in-process chain above on any MCP failure.
GEOCODE_BACKEND=inprocess

# ndvi_trend backend: "synthetic" (default, deterministic local demo data,
# clearly labeled data_source=synthetic_demo) or "gee" (real Google Earth
# Engine — requires the two vars below AND `pip install earthengine-api`).
NDVI_BACKEND=synthetic
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY_FILE=

# RAG embedding backend: "tfidf" (default, zero extra dependencies/network,
# pure numpy+jieba) or "bge" (real BAAI/bge-small-zh-v1.5 dense embeddings via
# sentence-transformers — needs that package installed AND internet access to
# Hugging Face on first use to download model weights).
EMBEDDING_BACKEND=tfidf
RAG_TOP_K=3

# Memory tuning
AGENT_LONG_TERM_DB_PATH=
AGENT_SUMMARY_TRIGGER_TURNS=10
AGENT_KEEP_RECENT_TURNS=4
AGENT_TOOL_CACHE_TTL=600

# Orchestrator bounds
AGENT_MAX_REPLANS=2
AGENT_MAX_TOOL_RETRIES=2
